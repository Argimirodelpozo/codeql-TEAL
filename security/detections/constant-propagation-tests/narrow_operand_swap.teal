#pragma version 8
// T1: operand-order symmetry. Both `txn F == K` and `K == txn F` should
// produce the same narrowing. Two assertions, each with a different
// operand order, followed by two reads.

// Order A: field LHS, constant RHS
txn Fee
int 1000
==
assert

// Order B: constant LHS, field RHS
int 5
txn TypeEnum
==
assert

// Both should narrow:
//   - txn Fee → 1000 (guard in order A)
//   - txn TypeEnum → 5 (guard in order B)
txn Fee
txn TypeEnum
+
return
