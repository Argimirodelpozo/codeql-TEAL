#pragma version 10
// Callee: when called with selector "trigger", emits an inner payment
// transaction whose Fee is set to a non-zero constant (1000 microalgos).
// Repeated invocations would drain the application account through
// accumulated fees — exactly what inner-txn-fee flags.

txna ApplicationArgs 0
pushbytes "trigger"
==
bnz trigger

err

trigger:
  itxn_begin
  pushint 1
  itxn_field TypeEnum                     // Payment
  txn Sender
  itxn_field Receiver
  pushint 0
  itxn_field Amount
  pushint 1000                            // BUG: non-zero fee
  itxn_field Fee
  itxn_submit

  pushint 1
  return
