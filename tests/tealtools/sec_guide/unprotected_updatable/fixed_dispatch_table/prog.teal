#pragma version 8
// FIXED: Full dispatch table with sender == creator on privileged paths

txn OnCompletion
int 0
==
bnz handle_noop

txn OnCompletion
int 4
==
bnz handle_update

txn OnCompletion
int 5
==
bnz handle_delete

// Reject everything else
err

handle_noop:
  callsub business_logic
  int 1
  return

handle_update:
  // Properly protected
  callsub require_creator
  int 1
  return

handle_delete:
  callsub require_creator
  int 1
  return

business_logic:
  int 42
  pop
  retsub

require_creator:
  txn Sender
  global CreatorAddress
  ==
  assert
  retsub
