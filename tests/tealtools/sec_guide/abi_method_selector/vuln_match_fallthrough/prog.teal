// NO-match edge (selector not pinned to a constant) and must stay flagged.
txn NumAppArgs
int 1
>=
assert
pushbytes 0x12345678
pushbytes 0x9abcdef0
txna ApplicationArgs 0
match handler_a handler_b
int 1
return
handler_a:
  int 1
  return
handler_b:
  int 1
  return
