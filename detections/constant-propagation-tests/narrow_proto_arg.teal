#pragma version 8
// T3: field passed as proto-sub argument, guarded INSIDE the sub. The
// narrowing should flow back through the callsub bridge so that the
// caller's continuation reads of `txn Fee` narrow to the guarded value.
//
// NOTE: today's fieldReadKey / narrowing machinery operates on the
// caller's BB vs dominating guards in the CALLER'S CFG. A guard inside
// the sub dominates the sub's BBs and (via retsub edges) the
// post-callsub BBs. So a read of `txn Fee` AFTER the callsub should
// see the sub's assert as a dominating guard IF the CFG models the
// retsub→callsite edge correctly.

txn Fee
callsub assert_fee_is_1000

// Back in caller — is Fee narrowed here?
txn Fee          // ideally narrows to 1000
pop
int 1
return

assert_fee_is_1000:
  proto 1 0
  frame_dig -1
  int 1000
  ==
  assert
  retsub
