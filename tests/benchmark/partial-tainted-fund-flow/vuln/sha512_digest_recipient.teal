#pragma version 10
// The recipient is a slice of sha512(arg): the attacker controls bytes [4:) of the
// preimage, hence the digest. The 4-byte selector check validates only the prefix.
// Pins: the byte engine must tag sha512 BYTES (it fell to the scalar fallback).
    txna ApplicationArgs 0
    extract 0 4
    byte 0x11223344
    ==
    assert
    itxn_begin
    int pay
    itxn_field TypeEnum
    int 1000
    itxn_field Amount
    txna ApplicationArgs 0
    sha512
    extract 0 32
    itxn_field Receiver
    itxn_submit
    int 1
    return
