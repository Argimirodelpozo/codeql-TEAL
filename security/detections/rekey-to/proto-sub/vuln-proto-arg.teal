#pragma version 8
// VULNERABLE: Like fixed-proto-arg, but the proto subroutine is only
// called on the payment path — the app-call branch reaches the approval
// exit without ever passing RekeyTo through the sub.

txn TypeEnum
int 1
==
bnz payment_path

// App call path — bypasses assert_is_zero_addr
txn OnCompletion
int 0
==
assert
b approve

payment_path:
txn RekeyTo
callsub assert_is_zero_addr
txn Amount
int 500000
<=
assert

approve:
int 1
return

assert_is_zero_addr:
  proto 1 0
  frame_dig -1
  global ZeroAddress
  ==
  assert
  retsub
