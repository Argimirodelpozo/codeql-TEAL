# Local test-fixture contract dirs: heavy, kept out of git. The .teal
# sources (and any compiled output) live locally and are regenerated on
# demand; the small curated fixtures tracked elsewhere are not affected.
*-db/
tests/dbs/
# Experimental IR-lift corpus: keep the .teal sources, ignore the heavy DBs
tests/experimental_IR_lift/**/db/

# Editor / IDE / agent state
.claude/
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
.ipynb_checkpoints/

# Local lift dumps — scratch output from the IR/SSA/structure CLIs at top level
/*.puya.ir
/*.puya.opt.ir
/*.ssa.ir
/*.ssa.ir.txt
