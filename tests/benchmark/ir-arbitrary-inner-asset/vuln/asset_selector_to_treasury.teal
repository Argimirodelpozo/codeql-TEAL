#pragma version 10
    // claim(asset): pay out a caller-named asset to a fixed treasury/other addr.
    // Tinyman-class confusion: the attacker names which asset leaves the app's
    // holdings; it is never pinned and does not return to the caller.
    txna ApplicationArgs 0
    byte 0xc0ffee00
    ==
    assert
    itxn_begin
    int axfer
    itxn_field TypeEnum
    txna ApplicationArgs 1
    btoi
    itxn_field XferAsset
    addr AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA5HFFY
    itxn_field AssetReceiver
    int 1000
    itxn_field AssetAmount
    itxn_submit
    int 1
    return
