#pragma version 10
// SAFE: a real sender guard whose RESULT is round-tripped through scratch
// before its assert. The lift keeps store/load as IR intrinsics and rebuilds
// from the op stream, so the def-walk used to dead-end at `(load 0)`;
// `_scratch_value_edges` now bridges it under must-semantics.
txn Sender
global CreatorAddress
==
store 0
load 0
assert
itxn_begin
int pay
itxn_field TypeEnum
txna ApplicationArgs 0
itxn_field Receiver
int 1000
itxn_field Amount
itxn_submit
int 1
return
