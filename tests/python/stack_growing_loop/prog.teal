#pragma version 10
// Stack-growing loop: each iteration's body has net +1 stack delta
// (pushint +1, txna +1, btoi 0, bnz -1 = +1). Static-depth analysis
// in nodeStackDepth therefore propagates an ever-growing depth at
// l_loop's entry — depth ∈ {0, 1, 2, …}, saturating just shy of the
// AVM 1000-element cap (`pushint` after depth=999 would push to 1000
// which is OK; the next pushint would hit 1001 and gets pruned).
//
// Demonstration: the stacksim's depth-bound cutoff
// (`max(stack_heights at bb.firstNode)` for the loop-body BB) ≈ 999,
// i.e. essentially the AVM cap. The cutoff is sound but offers no
// useful trim — every IndirectPhi the SSA model generated up to slot
// 999 stays. The dump at l_loop becomes ~1000 phis wide.

pushint 0                       // seed the loop with one element on stack

l_loop:
pushint 1                       // grows stack by 1 per iter
txna ApplicationArgs 0          // bnz argument source
btoi
bnz l_loop

pushint 1
return
