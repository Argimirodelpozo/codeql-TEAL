#pragma version 8
// T3: field read stored to scratch, loaded back, then guarded. The
// narrowing should propagate via the scratch bridge:
//   txn Fee → store 0 → load 0 → cmp → assert
// After the assert, a downstream `txn Fee` read should narrow to 1000
// because the cmp's left operand resolves (via scratchBridge + LocalFlow)
// to a txn Fee field read.

txn Fee
store 0

// ... some unrelated work ...
txn Amount
int 500000
<=
assert

load 0
int 1000
==
assert

// Downstream read — narrows to 1000?
txn Fee          // ideally narrows to 1000
pop
int 1
return
