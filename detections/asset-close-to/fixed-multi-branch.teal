#pragma version 8
// FIXED: AssetCloseTo checked in shared subroutine for all asset paths

txn TypeEnum
int 4
==
bnz is_axfer

txn Amount
int 100000
<=
assert
int 1
return

is_axfer:
  // Common asset safety checks first
  callsub asset_safety_checks

  txn XferAsset
  int 12345
  ==
  bnz handle_token_a

  txn XferAsset
  int 67890
  ==
  bnz handle_token_b

  err

handle_token_a:
  callsub validate_token_a
  int 1
  return

handle_token_b:
  callsub validate_token_b
  int 1
  return

asset_safety_checks:
  txn AssetCloseTo
  global ZeroAddress
  ==
  assert
  retsub

validate_token_a:
  txn AssetAmount
  int 1000
  <=
  assert
  txn AssetReceiver
  addr AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAY5HFKQ
  ==
  assert
  retsub

validate_token_b:
  txn AssetAmount
  int 500
  <=
  assert
  retsub
