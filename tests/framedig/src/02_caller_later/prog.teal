#pragma version 10
// Case 02: reproduces the xgov bug.
// `helper` (L6) is called by `main_logic` (L20, LATER in file).
// The `max-line-number` heuristic picks `main_logic` for frame_digs in `helper`.
// Expected after fix: frame_dig in helper -> helper, not main_logic.
intc_0
callsub main_logic
return

helper:
    proto 1 1
    frame_dig -1
    intc_1
    +
    retsub

main_logic:
    proto 0 0
    pushint 5
    callsub helper
    pop
    retsub
