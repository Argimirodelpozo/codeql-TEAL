#pragma version 10
// SAFE: the same OnCompletion guard, reaching its assert through a phi. A phi
// has no `defined_by` at all, so the guard was invisible — even though both
// arms carry the identical value.
txn OnCompletion
int DeleteApplication
!=
store 0
txn NumAppArgs
bnz alt
load 0
b join
alt:
load 0
join:
assert
byte "k"
app_global_get
pop
int 1
return
