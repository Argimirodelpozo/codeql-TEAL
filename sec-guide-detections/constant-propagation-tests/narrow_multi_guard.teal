#pragma version 8
// T2: two disjoint guards with different values for the same field.
// On each branch a different K is asserted. A read on branch A narrows
// to K_A only; a read on branch B narrows to K_B only; there is no
// post-join read so no multi-value case here (see narrow_phi_join for
// that).

txn TypeEnum
int 1
==
bnz branch_a

// branch B: Fee == 2000
txn Fee
int 2000
==
assert
txn Fee          // should narrow to 2000 ONLY
pop
int 0
return

branch_a:
// branch A: Fee == 1000
txn Fee
int 1000
==
assert
txn Fee          // should narrow to 1000 ONLY
pop
int 1
return
