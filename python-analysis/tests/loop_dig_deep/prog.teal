#pragma version 10
// Loop body reads a slot pushed by the PREVIOUS iteration via dig 1.
// On iter 1 the dug slot is the initial pre-loop value; from iter 2
// onwards it's the pushint produced by the previous iteration. This
// makes the deep-slot phi at l_loop genuinely *live* in the SSA
// model — there's a real consumer (the dig op) reading slot 2 of
// l_loop's entry stack.
//
// nodeStackDepth(l_loop) reports {1} because the back-edge from
// `bnz l_loop` is filtered out (`cb.getLineNumber() < lineNum` in
// StackDepth.qll). The current stacksim cutoff therefore clips at
// slot 1, hiding the real slot-2 phi → unsound under-reporting.

pushint 100                     // initial: slot 1 at l_loop entry on iter 1.

l_loop:
pushint 1                       // each iter pushes one element.
dig 1                           // read slot at depth 1 (under top).
                                // iter 1: reads the initial 100.
                                // iter 2+: reads the previous-iter pushint.
pop                             // consume the dug copy (creates the use).

txna ApplicationArgs 0
btoi
bnz l_loop                      // back-edge to l_loop with depth grown.

return
