#pragma version 8
// T1: bytes narrowing via bz-to-err. On the fall-through (cmp=true) the
// address is known; on the target (cmp=false) we err.

txn Sender
pushbytes 0x2222222222222222222222222222222222222222222222222222222222222222
==
bz reject

// fall-through: txn Sender is known
txn Sender       // should narrow to 0x2222...2222
pop
int 1
return

reject:
err
