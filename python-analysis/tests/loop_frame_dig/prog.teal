#pragma version 10
// Same shape as loop_dig_deep but inside a proto-ful subroutine,
// using frame_dig -1 to read the input arg from each iteration.
//
// In the SSA model, frame_dig consumes the entire band from the
// frame slot up to the current top of stack — so the consumed-band
// width depends on the runtime stack depth at the op. As the loop
// grows the stack each iteration, the band grows too, and the SSA
// emits phis at every slot in that growing band. Without the
// stacksim fix, those slot-N phis get clipped by the
// nodeStackDepth cutoff (which is unsound here because of the bnz
// back-edge); with the fix, every phi is shown.

intc_0
callsub mysub
return

mysub:
proto 1 1

l_loop:
frame_dig -1                    // copy the input arg onto top.
txna ApplicationArgs 0
btoi
bnz l_loop                      // back-edge — self-loop on the
                                // l_loop BB.

pushint 0
retsub
