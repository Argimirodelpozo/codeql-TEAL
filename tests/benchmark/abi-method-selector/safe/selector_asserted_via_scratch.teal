#pragma version 10
// SAFE: the selector IS checked, but the comparison round-trips through scratch
// before the assert. This pins the immutable scratch identity relation used by
// path predicates: the exit is known to require selector == 0x12345678 without
// a second, detector-specific enforcement walk.
txna ApplicationArgs 0
byte 0x12345678
==
store 0
load 0
assert
int 1
return
