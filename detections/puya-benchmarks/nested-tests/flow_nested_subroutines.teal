#pragma version 8
bytecblock "k1" "k2" "k3" "k4"

// --- Test A: top-level source through outer (which calls nested) back to top
bytec_0
txna ApplicationArgs 0
callsub outer_passthrough
app_global_put

// --- Test B: second callsite for outer_passthrough (call-site sensitivity)
bytec_1
txna ApplicationArgs 1
callsub outer_passthrough
app_global_put

// --- Test C: flow from inside outer (global), through nested, back to top
bytec_2
callsub outer_with_inner_global
app_global_put

// --- Test D: flow from inside nested, back through outer, back to top
bytec_3
callsub outer_calls_nested_source
app_global_put

intc_0
return

// outer_passthrough: takes 1 arg, passes to nested, returns nested's result
outer_passthrough:
    proto 1 1
    frame_dig -1
    callsub nested_passthrough
    retsub

// nested_passthrough: just returns its arg
nested_passthrough:
    proto 1 1
    retsub

// outer_with_inner_global: internal source (global) passed through nested
outer_with_inner_global:
    proto 0 1
    global LatestTimestamp
    callsub nested_passthrough
    retsub

// outer_calls_nested_source: returns whatever nested_internal_source produces
outer_calls_nested_source:
    proto 0 1
    callsub nested_internal_source
    retsub

// nested_internal_source: internal source (txn Sender)
nested_internal_source:
    proto 0 1
    txn Sender
    retsub
