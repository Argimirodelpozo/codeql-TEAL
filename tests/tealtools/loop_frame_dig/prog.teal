#pragma version 10
// Same shape as loop_dig_deep but inside a proto-ful subroutine,
// using frame_dig -1 to read the input arg from each iteration.
//
// The loop GROWS the stack by one per lap (the dug copy is never
// consumed), so no single depth describes the header and the
// region is depth-poisoned. Frame positions are LAP-INVARIANT
// (the base does not move), so the band plan resolves the dig
// straight to the region-entry cell — the sub's argument — on
// every lap; no phi is needed and none survives the live filter.

intc_0
callsub mysub
return

mysub:
proto 1 1

l_loop:
frame_dig -1                    // copy the input arg onto top.
txna ApplicationArgs 0
btoi
bnz l_loop                      // back-edge — self-loop on the
                                // l_loop BB.

pushint 0
retsub
