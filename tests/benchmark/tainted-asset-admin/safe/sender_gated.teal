    txn Sender
    byte "owner"
    app_global_get
    ==
    assert
    itxn_begin
    int acfg
    itxn_field TypeEnum
    int 100
    itxn_field ConfigAsset
    txna ApplicationArgs 0
    itxn_field ConfigAssetClawback
    itxn_submit
    int 1
    return
