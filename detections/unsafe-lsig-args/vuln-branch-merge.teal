#pragma version 8
// VULNERABLE: arg compared on one branch, but the OTHER branch also
// uses a different arg for gating — both paths use args for auth

txn Amount
int 100000
>
bnz high_value_path

// Low-value path: arg_0 is the "password"
arg_0
pushbytes "low_val_key"
==
assert
b common_checks

high_value_path:
// High-value path: arg_1 is the "admin password"
arg_1
pushbytes "adm1n_key"
==
assert
// Extra check for high value — but still arg-based, so still vuln
arg_2
pushbytes "2fa_token"
==
assert

common_checks:
txn Fee
global MinTxnFee
<=
assert
txn RekeyTo
global ZeroAddress
==
assert
int 1
return
