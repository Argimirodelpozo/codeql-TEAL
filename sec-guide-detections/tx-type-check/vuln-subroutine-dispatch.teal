#pragma version 8
// VULNERABLE: Complex subroutine-based logic but no TypeEnum check
// Contract performs amount/receiver validation but any tx type is accepted

callsub validate_amount
callsub validate_receiver
callsub validate_safety
int 1
return

// Missing: callsub validate_type  (or inline TypeEnum check)

validate_amount:
  txn Amount
  int 1000000
  <=
  assert
  retsub

validate_receiver:
  txn Receiver
  addr AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAY5HFKQ
  ==
  assert
  retsub

validate_safety:
  txn Fee
  global MinTxnFee
  <=
  assert
  txn RekeyTo
  global ZeroAddress
  ==
  assert
  txn CloseRemainderTo
  global ZeroAddress
  ==
  assert
  retsub
