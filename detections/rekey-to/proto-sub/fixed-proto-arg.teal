#pragma version 8
// FIXED: RekeyTo value is read in the caller and passed as an explicit
// proto-sub ARGUMENT. The sub then reads the arg via frame_dig -1 and
// asserts it equals ZeroAddress. Exercises `callsubBridge` (flow from
// caller-side SSAVar into the sub's frame-dig output SSAVar) and
// verifies that the cmp output reaches an assert inside the sub body.

txn RekeyTo
callsub assert_is_zero_addr

txn TypeEnum
int 1
==
bnz payment_path

txn OnCompletion
int 0
==
assert
b approve

payment_path:
txn Amount
int 500000
<=
assert

approve:
int 1
return

assert_is_zero_addr:
  proto 1 0
  frame_dig -1
  global ZeroAddress
  ==
  assert
  retsub
