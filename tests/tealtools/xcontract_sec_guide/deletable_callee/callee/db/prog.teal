#pragma version 10
// Callee: routes by ApplicationArgs[0]. The "do_thing" handler approves
// regardless of OnCompletion, so OC=DeleteApplication (5) reaches an
// approval exit unguarded. is-deletable + unprotected-deletable should
// fire here when run cross-contract.

txna ApplicationArgs 0
pushbytes "do_thing"
==
bnz do_thing

txna ApplicationArgs 0
pushbytes "do_other"
==
bnz do_other

err

do_thing:
  // No OnCompletion check — anyone can call with OC=5 to delete.
  // Also no Sender == CreatorAddress check — unprotected delete.
  pushint 1
  return

do_other:
  pushint 1
  return
