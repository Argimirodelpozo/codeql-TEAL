#pragma version 10
// Same shape as loop_dig_deep but inside a proto-ful subroutine,
// using frame_dig -1 to read the input arg from each iteration.
//
// The loop GROWS the stack by one per lap (the dug copy is never
// consumed), so no single depth describes the header. The
// simulator merges its predecessors TOP-ALIGNED and takes the
// shallowest window — one cell here — so the header carries one
// phi over {the entry's arg, the previous lap's dug copy}. Both
// resolve to the same arg, since a frame_dig IS a copy of what it
// read; the phi records that the header is reached two ways, not
// that the value is in doubt.

intc_0
callsub mysub
return

mysub:
proto 1 1

l_loop:
frame_dig -1                    // copy the input arg onto top.
txna ApplicationArgs 0
btoi
bnz l_loop                      // back-edge — self-loop on the
                                // l_loop BB.

pushint 0
retsub
