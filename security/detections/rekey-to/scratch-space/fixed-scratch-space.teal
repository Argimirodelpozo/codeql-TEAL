#pragma version 8
// FIXED: RekeyTo is stored into scratch slot 0 exactly once and then
// loaded and asserted against ZeroAddress before any branching.
// Every approval exit is dominated by the load-and-assert, so the
// scratch-routed check protects all paths.

txn RekeyTo
store 0

// Validate RekeyTo from scratch space early
load 0
global ZeroAddress
==
assert

txn TypeEnum
int 1
==
bnz payment_path

txn OnCompletion
int 0
==
assert
b approve

payment_path:
txn Amount
int 500000
<=
assert

approve:
int 1
return
