#pragma version 10
// Caller: appcalls AppID 7000003 with selector "trigger".
// The callee submits an inner txn with a non-zero Fee — surfaces
// inner-txn-fee via the cross-contract sec-guide layer.

itxn_begin
pushint 6
itxn_field TypeEnum
pushint 7000003
itxn_field ApplicationID
pushbytes "trigger"
itxn_field ApplicationArgs
itxn_submit

pushint 1
return
