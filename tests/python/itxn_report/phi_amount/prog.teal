#pragma version 10
// Single itxn_begin/submit. Amount is set from a phi over two
// branches that join *before* the itxn_field op. Report should
// render Amount as {100 | 200}.

itxn_begin
pushint 1
itxn_field TypeEnum
txn Sender
itxn_field Receiver

txna ApplicationArgs 0
btoi
bnz l_high

pushint 100
b l_set_amount

l_high:
pushint 200

l_set_amount:
itxn_field Amount

itxn_submit

pushint 1
return
