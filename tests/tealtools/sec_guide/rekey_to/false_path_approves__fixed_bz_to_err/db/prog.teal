#pragma version 8
// FIXED: branch-based rejection via `bz reject; int 1 return; reject: err`.
// When the cmp is false (0), `bz` takes the branch to the `reject` label
// whose first op is `err`, so the program rejects. When the cmp is true,
// `bz` falls through to the approval.

txn RekeyTo
global ZeroAddress
==
bz reject
int 1
return

reject:
err
