#pragma version 10
// Scenario: countdown loop. The counter value lives across the back
// edge, so phi at `loop_head` depends (via the propagation chain) on
// itself. This is the termination stress-test for `phiIsLive`'s
// fixpoint: a cycle in the propagation graph must not hang, and any
// phi in the cycle whose value is eventually consumed (at `done`)
// must be kept alive.
pushint 10
loop_head:
    dup
    intc_0
    ==
    bnz done
    intc_1
    -
    b loop_head
done:
    pop
    intc_0
    return
