#pragma version 8
// T1: bytes narrowing via bnz target. `txn Sender == <addr>; bnz known`.
// On the `known:` branch, txn Sender should narrow to the hex literal.

txn Sender
pushbytes 0x1111111111111111111111111111111111111111111111111111111111111111
==
bnz known

err

known:
txn Sender       // should narrow to 0x1111...1111
pop
int 1
return
