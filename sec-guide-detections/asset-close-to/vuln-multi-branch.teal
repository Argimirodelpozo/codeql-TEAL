#pragma version 8
// VULNERABLE: Multiple asset handling paths via subroutines
// AssetCloseTo not checked on any path

txn TypeEnum
int 4
==
bnz is_axfer

// Non-asset path — fine
txn Amount
int 100000
<=
assert
int 1
return

is_axfer:
  // Dispatch by asset ID
  txn XferAsset
  int 12345
  ==
  bnz handle_token_a

  txn XferAsset
  int 67890
  ==
  bnz handle_token_b

  // Unknown asset — reject
  err

handle_token_a:
  callsub validate_token_a
  int 1
  return

handle_token_b:
  callsub validate_token_b
  int 1
  return

validate_token_a:
  txn AssetAmount
  int 1000
  <=
  assert
  txn AssetReceiver
  addr AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAY5HFKQ
  ==
  assert
  // Missing: txn AssetCloseTo == global ZeroAddress
  retsub

validate_token_b:
  txn AssetAmount
  int 500
  <=
  assert
  // Missing: txn AssetCloseTo == global ZeroAddress
  retsub
