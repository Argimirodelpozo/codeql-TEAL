#pragma version 10
// Scenario: a single DirectPhi, consumed in its own BB by the load/store.
// Two predecessor BBs both push a value, they join, the successor BB
// consumes the stack slot via `store`.
//
// Expected phis: exactly one DirectPhi at the join BB (join:), stack
// index 1. No IndirectPhis should propagate anywhere.
intc_0
bnz branch_a
pushint 1
b join
branch_a:
    pushint 2
join:
    store 0
    pushint 0
    return
