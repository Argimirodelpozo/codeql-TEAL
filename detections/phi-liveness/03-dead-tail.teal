#pragma version 10
// Scenario: a value is pushed in the entry BB, a conditional branch skips
// over the consumer and goes to a tail that returns without consuming.
// On the consuming side, the value IS used; on the dead side, the stack
// is left dangling (which is a runtime error but legal syntactically).
//
// Expected: the consumer-side DirectPhi / IndirectPhi chain is live.
// The dead-tail IndirectPhis that would pessimistically propagate the
// value across the skip-to-return tail MUST be pruned by our filter.
pushint 7
intc_0
bnz dead_tail

    // Live-consumer path
    store 0
    intc_0
    return

dead_tail:
    // The pushed value is still on the stack here, but we never consume
    // it. Any IndirectPhis propagating into this tail should be pruned.
    intc_0
    return
