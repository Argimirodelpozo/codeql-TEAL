#pragma version 8
// VULNERABLE: RekeyTo checked on one branch but NOT on the other
// The "fast path" skips the rekey check entirely

txn TypeEnum
int 1
==
bnz payment_path

// Asset transfer path — has RekeyTo check
txn RekeyTo
global ZeroAddress
==
assert
txn XferAsset
int 12345
==
assert
b approve

payment_path:
// Payment path — MISSING RekeyTo check!
txn Amount
int 500000
<=
assert
txn Fee
global MinTxnFee
<=
assert
// Forgot to check RekeyTo here

approve:
int 1
return
