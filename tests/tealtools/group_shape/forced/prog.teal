#pragma version 10
// Forces a 2-txn group: this is gtxn[1] (appl), gtxn[0] is a pay
// to this app's address.

global GroupSize
pushint 2
==
assert

txn GroupIndex
pushint 1
==
assert

gtxn 0 TypeEnum
pushint 1
==
assert

gtxn 0 Receiver
global CurrentApplicationAddress
==
assert

pushint 1
return
