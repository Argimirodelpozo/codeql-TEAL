#pragma version 8
// FIXED: Proto subroutine validates RekeyTo and is called before
// any branching — dominates all approval exits

callsub safety_checks

txn TypeEnum
int 1
==
bnz payment_path

// App call path
txn OnCompletion
int 0
==
assert
b approve

payment_path:
txn Amount
int 500000
<=
assert

approve:
int 1
return

safety_checks:
  proto 0 0
  txn RekeyTo
  global ZeroAddress
  ==
  assert
  txn Fee
  global MinTxnFee
  <=
  assert
  txn CloseRemainderTo
  global ZeroAddress
  ==
  assert
  retsub
