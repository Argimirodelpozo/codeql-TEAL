#pragma version 8
// T1: bnz cross-branch isolation. `cmp; bnz target; ...fall-through...;
// target: ...`. On the target branch cmp=true (we store the fact); on
// the fall-through cmp=false (we don't store disequalities, so reads
// there must NOT narrow).

txn Fee
int 1000
==
bnz target

// fall-through (cmp was false, Fee != 1000) — must NOT narrow
txn Fee          // should NOT narrow
pop
int 0
return

target:
// target (cmp was true, Fee == 1000) — SHOULD narrow
txn Fee          // should narrow to 1000
pop
int 1
return
