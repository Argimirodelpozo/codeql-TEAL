#pragma version 8
// SAFE: the receiver pin is enforced by branching to a subroutine "reject" arm
// that returns 0 (int 0; retsub) — a program rejection, just expressed via the
// sub's return value rather than a top-level `return 0` / `err`.
callsub validate
gtxn 1 Amount
pop
int 1
return
validate:
gtxn 1 Receiver
global CurrentApplicationAddress
==
bz reject
int 1
retsub
reject:
int 0
retsub
