#pragma version 8
// VULNERABLE: Proto subroutine checks RekeyTo but is only called
// on the payment path — app call path bypasses it

txn TypeEnum
int 1
==
bnz payment_path

// App call path — no safety checks, no RekeyTo validation
txn OnCompletion
int 0
==
assert
b approve

payment_path:
// Payment path — calls safety subroutine with proto
txn Amount
int 500000
<=
assert
callsub safety_checks

approve:
int 1
return

safety_checks:
  proto 0 0
  txn RekeyTo
  global ZeroAddress
  ==
  assert
  txn Fee
  global MinTxnFee
  <=
  assert
  retsub
