#pragma version 8
// FIXED: TypeEnum checked in validation subroutine chain

callsub validate_type
callsub validate_amount
callsub validate_receiver
callsub validate_safety
int 1
return

validate_type:
  txn TypeEnum
  int 1
  ==
  assert
  retsub

validate_amount:
  txn Amount
  int 1000000
  <=
  assert
  retsub

validate_receiver:
  txn Receiver
  addr AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAY5HFKQ
  ==
  assert
  retsub

validate_safety:
  txn Fee
  global MinTxnFee
  <=
  assert
  txn RekeyTo
  global ZeroAddress
  ==
  assert
  txn CloseRemainderTo
  global ZeroAddress
  ==
  assert
  retsub
