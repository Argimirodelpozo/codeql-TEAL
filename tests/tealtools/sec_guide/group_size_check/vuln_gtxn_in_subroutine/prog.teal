#pragma version 8
// VULNERABLE: gtxn access is hidden inside subroutines — no GroupSize check
// Attacker can pad the group with extra transactions

callsub validate_payment
assert
callsub validate_app_call
assert
int 1
return

// Subroutine: check that txn 0 is a payment of correct amount
validate_payment:
  gtxn 0 TypeEnum
  int 1
  ==
  gtxn 0 Amount
  int 1000000
  >=
  &&
  gtxn 0 Receiver
  global CurrentApplicationAddress
  ==
  &&
  retsub

// Subroutine: check that txn 1 is this app call
validate_app_call:
  gtxn 1 TypeEnum
  int 6
  ==
  retsub

// Missing: global GroupSize == int 2
