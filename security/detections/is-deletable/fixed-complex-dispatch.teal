#pragma version 8
// FIXED: Complex dispatch that explicitly rejects Delete and Update

txn ApplicationID
int 0
==
bnz handle_create

txn OnCompletion
int 0
==
bnz handle_noop

txn OnCompletion
int 1
==
bnz handle_optin

txn OnCompletion
int 2
==
bnz handle_closeout

// Reject Update (4) and Delete (5) explicitly
txn OnCompletion
int 4
==
bnz reject

txn OnCompletion
int 5
==
bnz reject

// Reject unknown OnCompletion values
err

handle_create:
  callsub init_state
  int 1
  return

handle_noop:
  callsub business_logic
  int 1
  return

handle_optin:
  int 1
  return

handle_closeout:
  callsub cleanup_local
  int 1
  return

reject:
  err

init_state:
  pushbytes "initialized"
  int 1
  app_global_put
  retsub

business_logic:
  int 42
  pop
  retsub

cleanup_local:
  txn Sender
  pushbytes "balance"
  app_local_del
  retsub
