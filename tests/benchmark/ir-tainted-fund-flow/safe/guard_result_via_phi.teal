#pragma version 10
// SAFE: the same guard reaching its assert through a phi as well as scratch.
// Same bridge; the phi is followed by the existing def-walk once the scratch
// edge reconnects it to the `==`.
txn Sender
global CreatorAddress
==
store 0
txn NumAppArgs
bnz alt
load 0
b join
alt:
load 0
join:
assert
itxn_begin
int pay
itxn_field TypeEnum
txna ApplicationArgs 0
itxn_field Receiver
int 1000
itxn_field Amount
itxn_submit
int 1
return
