#pragma version 8
// FIXED: RekeyTo check in shared subroutine called on all paths

txn TypeEnum
int 1
==
bnz payment_path

// Asset transfer path
txn XferAsset
int 12345
==
assert
txn AssetAmount
int 1000
<=
assert
callsub safety_checks
b approve

payment_path:
// Payment path
txn Amount
int 500000
<=
assert
callsub safety_checks

approve:
int 1
return

// Shared safety subroutine — ensures RekeyTo, Fee on ALL paths
safety_checks:
  txn RekeyTo
  global ZeroAddress
  ==
  assert
  txn Fee
  global MinTxnFee
  <=
  assert
  txn CloseRemainderTo
  global ZeroAddress
  ==
  assert
  retsub
