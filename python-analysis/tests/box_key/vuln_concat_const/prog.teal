#pragma version 10
// VULN: concat with a STATIC PREFIX.
// "asa_" + AssetName collides for two ASAs that share a name.

txna ApplicationArgs 0
btoi
asset_params_get AssetName
assert                              // [name]
pushbytes "asa_"                    // [name, "asa_"]
swap                                // ["asa_", name]
concat                              // ["asa_" ++ name]   ← still tainted
pushint 64
box_create
pop

pushint 1
return
