#pragma version 8
// FIXED: multi-op gap between the cmp and the branch. The RekeyTo cmp's
// boolean output is composed with a Fee check via `&&` before being
// consumed by a `bnz all_ok; err` pair. The forward-reach walks through
// the `&&` step (cmp's def → &&'s def) and then matches the bnz-to-err
// base case — so enforcement is recognized even though the cmp is not
// directly consumed by bnz.

txn RekeyTo
global ZeroAddress
==
txn Fee
global MinTxnFee
<=
&&
bnz all_ok
err

all_ok:
int 1
return
