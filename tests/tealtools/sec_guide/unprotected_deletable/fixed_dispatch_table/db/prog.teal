#pragma version 8
// FIXED: Full dispatch table with shared creator gate subroutine

txn OnCompletion
int 0
==
bnz handle_noop

txn OnCompletion
int 4
==
bnz handle_update

txn OnCompletion
int 5
==
bnz handle_delete

err

handle_noop:
  callsub business_logic
  int 1
  return

handle_update:
  callsub require_creator
  int 1
  return

handle_delete:
  callsub require_creator
  // Drain remaining funds to creator before deleting
  callsub drain_to_creator
  int 1
  return

business_logic:
  int 42
  pop
  retsub

require_creator:
  txn Sender
  global CreatorAddress
  ==
  assert
  retsub

drain_to_creator:
  itxn_begin
  int 1
  itxn_field TypeEnum
  global CreatorAddress
  itxn_field Receiver
  global CurrentApplicationAddress
  balance
  global CurrentApplicationAddress
  min_balance
  -
  itxn_field Amount
  int 0
  itxn_field Fee
  itxn_submit
  retsub
