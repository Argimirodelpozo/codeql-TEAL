#pragma version 8
// VULNERABLE: Nested dispatch — outer branch checks OnCompletion,
// inner branch supposedly checks sender but has a logic bug that
// allows bypass

txn OnCompletion
int 0
==
bnz handle_noop

// All non-NoOp calls go through "admin_gate"
callsub admin_gate
// If we get here, admin_gate approved us

txn OnCompletion
int 4
==
bnz do_update

txn OnCompletion
int 5
==
bnz do_delete

err

handle_noop:
  int 1
  return

do_update:
  int 1
  return

do_delete:
  int 1
  return

// BUG: admin_gate checks sender but doesn't assert — just leaves
// the result on the stack and returns. The caller never checks it.
admin_gate:
  txn Sender
  global CreatorAddress
  ==
  // Missing: assert
  // The == result is left on stack, popped by callsub overhead,
  // and never actually enforced
  pop
  retsub
