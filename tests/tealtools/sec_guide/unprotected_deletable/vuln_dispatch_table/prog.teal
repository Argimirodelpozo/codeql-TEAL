#pragma version 8
// VULNERABLE: Dispatch table where delete path lacks creator check
// Update is protected but delete is not

txn OnCompletion
int 0
==
bnz handle_noop

txn OnCompletion
int 4
==
bnz handle_update

txn OnCompletion
int 5
==
bnz handle_delete

err

handle_noop:
  callsub business_logic
  int 1
  return

handle_update:
  // Update properly protected
  txn Sender
  global CreatorAddress
  ==
  assert
  int 1
  return

handle_delete:
  // BUG: No sender == creator check — anyone can delete!
  int 1
  return

business_logic:
  int 42
  pop
  retsub
