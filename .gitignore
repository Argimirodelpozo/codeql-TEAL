# Extractor build artifacts
src/security/detections/.codeql/
.codeql-extractors/
teal/extractor/target/

# CodeQL databases (generated by `codeql database create`)
*-db/
tests/dbs/
src/security/detections-dbs/

# Editor / IDE / agent state
.claude/
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/

# CodeQL runtime artifacts written into fixture DBs whenever a query
# is run against them (diagnostic dumps + per-run log files). Not
# part of the DB schema itself; safe to ignore.
tests/**/db/diagnostic/
tests/**/db/log/
algoplonk_demo/**/db/diagnostic/
algoplonk_demo/**/db/log/

# CodeQL query-evaluation cache inside each fixture DB. Regenerated
# on demand by the evaluator and mutated by every test run, so it
# can't be tracked without leaving the working tree perpetually
# dirty. The actual DB relations (*.rel / *.rel.meta / pools /
# strings) live alongside it and stay tracked.
tests/**/db/db-teal/*/cache/
algoplonk_demo/**/db/db-teal/*/cache/

# BQRS artifacts from ``codeql database run-queries`` (the batched
# entry point used by tealtools.graphs). Land under ``<db>/results/``
# per pack; regenerated whenever a CSV cache miss triggers a re-run.
tests/**/db/results/
algoplonk_demo/**/db/results/

# Sentinel file written by tealtools.graphs._ensure_pack_installed to
# avoid re-running 'codeql pack install' on every load (~5s JVM cost).
src/analysis/tealtools/queries/.pack_installed_sig
