#pragma version 10
// FIXED: a correct multi-method ABI router. The method-selector constants are
// pushed first, then the actual selector (txna ApplicationArgs 0) on top, then
// `match` routes to each handler and the final `err` rejects any UNKNOWN selector.
// Reaching handler_a / handler_b means the selector matched a known method, so the
// handler exits are protected — they must NOT be flagged.
txn NumAppArgs
int 1
>=
assert
pushbytes 0x12345678
pushbytes 0x9abcdef0
txna ApplicationArgs 0
match handler_a handler_b
err
handler_a:
  int 1
  return
handler_b:
  int 1
  return
