#pragma version 10
// Opcodes with parameterised immediates (index N, signed depth, etc.).
// Grammar / extractor regressions tend to silently strip these;
// asserting each opcode's immediate against the source line catches
// it immediately.

txna ApplicationArgs 0
pop
txna ApplicationArgs 2
pop
gtxn 0 Sender
pop
gtxn 1 Receiver
pop

pushint 1
return
