#pragma version 4
// SAFE: the sibling's Receiver is pinned to state "Escrow", whose only writer
// requires a CREATOR-SIGNED sibling (`gtxn 1 Sender == Creator`): the creator's
// signature covers the group id, so only the creator can set the escrow.
txna ApplicationArgs 0
byte "set_escrow"
==
bnz set_escrow
gtxn 1 Receiver
byte "Escrow"
app_global_get
==
assert
byte "credit"
gtxn 1 Amount
app_global_put
int 1
return
set_escrow:
gtxn 1 Sender
global CreatorAddress
==
assert
byte "Escrow"
txna ApplicationArgs 1
app_global_put
int 1
return
