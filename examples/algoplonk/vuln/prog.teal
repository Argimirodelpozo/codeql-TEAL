// BasicVerifier.expmod(base: bytes, exponent: bytes, modulus: bytes) -> bytes:
expmod:
    // /tmp/algoplonk_vuln/BasicVerifier.py:347-348
    // @subroutine
    // def expmod(base: BigUInt, exponent: BigUInt, modulus: BigUInt) -> BigUInt:
    proto 3 1
    // /tmp/algoplonk_vuln/BasicVerifier.py:350
    // result = BigUInt(1)
    bytec_1 // 0x01

expmod_while_top@1:
    // /tmp/algoplonk_vuln/BasicVerifier.py:351
    // while exponent > 0:
    frame_dig -2
    bytec_2 // 0x
    b>
    bz expmod_after_while@5
    // /tmp/algoplonk_vuln/BasicVerifier.py:352
    // if exponent % 2 == 1:
    frame_dig -2
    pushbytes 0x02
    b%
    bytec_1 // 0x01
    b==
    bz expmod_after_if_else@4
    // /tmp/algoplonk_vuln/BasicVerifier.py:353
    // result = (result * base) % modulus
    frame_dig 0
    frame_dig -3
    b*
    frame_dig -1
    b%
    frame_bury 0

expmod_after_if_else@4:
    // /tmp/algoplonk_vuln/BasicVerifier.py:354
    // exponent = exponent // 2
    frame_dig -2
    pushbytes 0x02
    b/
    frame_bury -2
    // /tmp/algoplonk_vuln/BasicVerifier.py:355
    // base = (base * base) % modulus
    frame_dig -3
    dup
    b*
    frame_dig -1
    b%
    frame_bury -3
    b expmod_while_top@1

expmod_after_while@5:
    // /tmp/algoplonk_vuln/BasicVerifier.py:356
    // return result
    frame_dig 0
    swap
    retsub


