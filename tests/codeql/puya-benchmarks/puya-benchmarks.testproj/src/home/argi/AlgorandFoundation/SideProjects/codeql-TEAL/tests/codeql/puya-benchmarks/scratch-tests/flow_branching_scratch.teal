#pragma version 8
bytecblock "k"

// Push a condition, branch into one of two blocks. Each block stores a
// different txna value into slot 0. The load sits after the join, so
// NEITHER store dominates it — both MAY reach.
txna ApplicationArgs 0
intc_0
bnz b_branch

// Branch A
txna ApplicationArgs 1
store 0
intc_0
b join

b_branch:
// Branch B
txna ApplicationArgs 2
store 0

join:
bytec_0
load 0
app_global_put

intc_0
return
