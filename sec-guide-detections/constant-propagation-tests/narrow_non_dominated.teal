#pragma version 8
// T1: negative test — guard on one branch, read on sibling branch.
// `txn Fee == 1000` is asserted only on the payment path. A read on the
// app-call path must NOT narrow because the guard does not dominate it.

txn TypeEnum
int 1
==
bnz payment_path

// app-call path — NO fee check
txn Fee          // should NOT narrow
pop
int 1
return

payment_path:
txn Fee
int 1000
==
assert
txn Fee          // SHOULD narrow to 1000
pop
int 1
return
