#pragma version 10
// Mixes scalar (TypeEnum, ApplicationID) and array (ApplicationArgs)
// itxn fields so getItxnField() must return both kinds.

itxn_begin
pushint 6
itxn_field TypeEnum
pushint 1234567
itxn_field ApplicationID
pushbytes "do_thing"
itxn_field ApplicationArgs
itxn_submit

pushint 1
return
