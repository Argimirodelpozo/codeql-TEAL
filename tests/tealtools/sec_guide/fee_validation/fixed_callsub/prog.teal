#pragma version 8
// FIXED: Fee check in shared subroutine, called before any approval path

callsub validate_fee

txn TypeEnum
int 1
==
bnz is_payment

// Application call path
txn OnCompletion
int 0
==
assert
b approve

is_payment:
// Payment path
txn Amount
int 500000
<=
assert
txn Receiver
addr AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAY5HFKQ
==
assert

approve:
int 1
return

validate_fee:
  txn Fee
  global MinTxnFee
  <=
  assert
  retsub
