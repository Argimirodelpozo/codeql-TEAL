#pragma version 10
// VULN: extract a fixed slice of AssetName as the key.
// Substring of a non-unique field is *more* collision-prone, not less.

txna ApplicationArgs 0
btoi
asset_params_get AssetName
assert                              // [name]
extract 0 8                         // [name[0:8]]   ← still tainted
pushint 64
box_create
pop

pushint 1
return
