# Editor / IDE / agent state
# Ignore local .claude state, but SHARE committed skills (project analysis
# capabilities for any model/user). `.claude/*` (not `.claude/`) leaves the dir
# traversable so the skills negation below can re-include its subtree.
.claude/*
!.claude/skills/
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.ipynb_checkpoints/

# Local lift dumps — scratch output from the IR/SSA/structure CLIs at top level
/*.puya.ir
/*.puya.opt.ir
/*.ssa.ir
/*.ssa.ir.txt

# Coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml

# uv virtualenv
.venv/
