#pragma version 8
// VULNERABLE: switch-on-OnCompletion includes OC=5 → handle_delete
// which approves. App IS deletable.

txn OnCompletion
switch handle_noop handle_optin handle_closeout handle_clear handle_update handle_delete
err          // OC > 5 → reject

handle_noop:
  int 1
  return

handle_optin:
  int 1
  return

handle_closeout:
  int 1
  return

handle_clear:
  int 1
  return

handle_update:
  int 1
  return

handle_delete:
  // BUG: delete approves
  int 1
  return
