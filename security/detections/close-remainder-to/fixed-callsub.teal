#pragma version 8
// FIXED: CloseRemainderTo validated via shared subroutine on all paths

// Common safety checks first
callsub common_safety

txn Amount
int 0
>
bnz deposit_path

// Withdraw path
txn Fee
global MinTxnFee
<=
assert
b approve

deposit_path:
txn Amount
int 1000000
<=
assert
txn Fee
global MinTxnFee
<=
assert

approve:
int 1
return

common_safety:
  txn CloseRemainderTo
  global ZeroAddress
  ==
  assert
  txn RekeyTo
  global ZeroAddress
  ==
  assert
  retsub
