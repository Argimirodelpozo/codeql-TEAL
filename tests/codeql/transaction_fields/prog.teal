#pragma version 10
// Verifies TxnOpcode.getField() and GtxnOpcode.getField() return
// the parsed field name as a string. Catches grammar / extractor
// regressions that would silently break field extraction.

txn Sender
pop
txn GroupIndex
pop
gtxn 0 TypeEnum
pop
gtxn 1 Receiver
pop

pushint 1
return
