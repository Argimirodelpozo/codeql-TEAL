#pragma version 8
// VULNERABLE: RekeyTo is stored into slot 0, but before the later load
// another `store 0` overwrites the slot with a hardcoded `global
// ZeroAddress`. The subsequent `load 0 ; global ZeroAddress ; == ; assert`
// sequence therefore asserts ZeroAddress == ZeroAddress (always true),
// completely bypassing the actual RekeyTo check. A purely reachability-
// based "does a cmp receiving RekeyTo exist on the path?" check would be
// wrong here because the cmp never actually receives the RekeyTo value
// — the overwriting store kills the flow through the scratch bridge.

txn RekeyTo
store 0

txn Amount
int 500000
<=
assert

// Overwrite slot 0 with a constant that always equals what we compare
// it to. From this point on, `load 0` returns ZeroAddress, NOT RekeyTo.
global ZeroAddress
store 0

// This `assert` looks like a RekeyTo check, but it is comparing
// ZeroAddress to ZeroAddress — it always passes.
load 0
global ZeroAddress
==
assert

int 1
return
