#pragma version 8
// VULNERABLE: Switch-style dispatch where UpdateApplication falls
// through to the default approve path

txn OnCompletion
int 0
==
bnz handle_noop

txn OnCompletion
int 5
==
bnz handle_delete

// Developer handled NoOp and Delete but forgot Update (4)
// Update falls through to the approve below
int 1
return

handle_noop:
  callsub business_logic
  int 1
  return

handle_delete:
  // Delete is properly blocked
  err

business_logic:
  // Complex subroutine with internal branching
  int 1
  store 0
  load 0
  int 1
  ==
  bnz logic_path_a

  int 0
  retsub

  logic_path_a:
    int 1
    retsub
