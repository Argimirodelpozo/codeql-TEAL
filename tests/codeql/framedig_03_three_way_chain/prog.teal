#pragma version 10
// Case 03: three-level call chain A -> B -> C.
// frame_dig inside each sub must resolve to that sub, not any outer caller.
// Order in file: C (innermost) first, then B, then A — inverted from call chain.
intc_0
callsub A
return

C:
    proto 1 1
    frame_dig -1
    intc_0
    +
    retsub

B:
    proto 1 1
    frame_dig -1
    callsub C
    retsub

A:
    proto 0 0
    pushint 42
    callsub B
    pop
    retsub
