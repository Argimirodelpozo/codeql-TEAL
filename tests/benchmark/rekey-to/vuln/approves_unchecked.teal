#pragma version 10
    // Lsig-legal body (no app-state ops — rekey-to is an lsig-only detector, and
    // `scan()` never runs it on an application). A delegated lsig that pins the
    // Fee on a bz branch, then approves without ever reading RekeyTo: the signer
    // can be rekeyed to the attacker.
    txn Fee
    int 1000
    <=
    bz reject
    int 1
    return
reject:
    int 0
    return
