#pragma version 8
// FIXED: counterpart to vuln-scratch-app-arg-overwrite.teal. The RekeyTo
// value stored into slot 0 at entry is loaded and asserted before slot 0
// is reused to hold ApplicationArgs[0]. The overwrite is harmless
// because the RekeyTo check has already fired.

txn RekeyTo
store 0

// Fire the check before the slot is reused for ApplicationArgs[0]
load 0
global ZeroAddress
==
assert

// Safe to overwrite now.
txna ApplicationArgs 0
store 0

int 1
return
