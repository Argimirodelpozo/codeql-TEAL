#pragma version 8
// FIXED: counterpart to vuln-scratch-overwrite.teal. Slot 0 is reused
// later in the program, but the RekeyTo value stored at entry is loaded
// and asserted BEFORE the overwrite happens. After the assertion fires
// the slot can be freely reused for unrelated data.

txn RekeyTo
store 0

// Fire the check before reusing the slot
load 0
global ZeroAddress
==
assert

// Now that RekeyTo has been asserted, slot 0 can be safely reused.
global ZeroAddress
store 0

int 1
return
