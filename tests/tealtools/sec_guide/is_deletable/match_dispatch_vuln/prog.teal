#pragma version 8
// VULNERABLE: match-on-OnCompletion includes OC=5 → handle_delete
// which approves. App IS deletable.

int 0       // candidate for handle_noop
int 1       // candidate for handle_optin
int 2       // candidate for handle_closeout
int 3       // candidate for handle_clear
int 4       // candidate for handle_update
int 5       // candidate for handle_delete
txn OnCompletion
match handle_noop handle_optin handle_closeout handle_clear handle_update handle_delete
err          // OC > 5 → reject

handle_noop:
  int 1
  return

handle_optin:
  int 1
  return

handle_closeout:
  int 1
  return

handle_clear:
  int 1
  return

handle_update:
  int 1
  return

handle_delete:
  // BUG: delete approves
  int 1
  return
