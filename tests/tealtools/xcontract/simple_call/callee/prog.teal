#pragma version 10
// Callee: dispatches on ApplicationArgs[0].

txna ApplicationArgs 0
pushbytes "do_thing"
==
bnz do_thing

txna ApplicationArgs 0
pushbytes "do_other"
==
bnz do_other

err

do_thing:
pushbytes "k"
pushint 42
app_global_put              // sensitive: no callee-side guard
pushint 1
return

do_other:
pushint 1
return
