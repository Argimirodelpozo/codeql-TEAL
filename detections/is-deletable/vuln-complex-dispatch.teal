#pragma version 8
// VULNERABLE: Complex multi-handler dispatch where DeleteApplication
// reaches approval through a non-obvious path

// First level: separate creation from everything else
txn ApplicationID
int 0
==
bnz handle_create

// Second level: dispatch by OnCompletion
txn OnCompletion
int 0
==
bnz handle_noop

txn OnCompletion
int 1
==
bnz handle_optin

txn OnCompletion
int 2
==
bnz handle_closeout

// Anything else (including 4=Update and 5=Delete) falls through
// Developer thought this would be caught by the err below, but
// they accidentally put the approve label before it
b handle_privileged

handle_create:
  int 1
  return

handle_noop:
  callsub business_logic
  int 1
  return

handle_optin:
  int 1
  return

handle_closeout:
  int 1
  return

handle_privileged:
  // Developer intended to add access control here but hasn't yet
  // Both Update and Delete reach approval!
  int 1
  return

business_logic:
  int 42
  pop
  retsub
