#pragma version 8
// VULNERABLE: RekeyTo stored in scratch space but only validated
// on one branch — payment path bypasses the check

txn RekeyTo
store 0

txn TypeEnum
int 1
==
bnz payment_path

// App call path — loads from scratch and validates
load 0
global ZeroAddress
==
assert
txn OnCompletion
int 0
==
assert
b approve

payment_path:
// Payment path — never loads slot 0, RekeyTo unchecked!
txn Amount
int 500000
<=
assert

approve:
int 1
return
