#pragma version 10
// Two-txn grouped itxn: pay then asset-transfer.

itxn_begin
pushint 1                       // pay
itxn_field TypeEnum
txn Sender
itxn_field Receiver
pushint 50
itxn_field Amount

itxn_next
pushint 4                       // axfer
itxn_field TypeEnum
txn Sender
itxn_field AssetReceiver
pushint 7777
itxn_field XferAsset
pushint 1
itxn_field AssetAmount

itxn_submit

pushint 1
return
