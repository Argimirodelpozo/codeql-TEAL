#pragma version 8
// Guard pins `gtxn 0 Fee` to a constant, then a later read of `gtxn 0 Fee`
// on a dominated branch narrows to the same constant. A sibling read of
// `gtxn 1 Fee` (different txn index) must NOT narrow because its key is
// different.

gtxn 0 Fee
int 1000
==
assert

// should narrow to 1000
gtxn 0 Fee
// should NOT narrow (different index)
gtxn 1 Fee
+
return
